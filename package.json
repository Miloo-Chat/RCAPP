{
  "name": "rcapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "npm --prefix server start || node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "npx concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "test": "bash scripts/no-bots-check.sh && node tests/test_no_bots.cjs",
    "test:ad-isolation": "node tests/test_ad_isolation.cjs",
    "test:crawl": "node tests/verify_crawl.cjs",
    "test:content-qa": "node tests/qa_content_audit.cjs",
    "test:moderation": "node tests/test_moderation.cjs",
    "test:admin-security": "node tests/test_admin_security.cjs",
    "test:two-browsers": "node tests/test_two_browsers_no_bots.cjs",
    "test:pa11y": "node tests/test_a11y.cjs",
    "test:lighthouse": "node tests/run_lighthouse.cjs",
    "quality-gate": "node tests/test_ad_isolation.cjs && cd client && npm run build && cd .. && node tests/qa_content_audit.cjs && node tests/verify_crawl.cjs"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "^15.4.0",
    "puppeteer": "^25.16.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}

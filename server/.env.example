# Server Port
PORT=5000

# Administrative Moderation Authentication
# ADMIN_PASSWORD_HASH must be a bcrypt/argon2 hash. Generate via:
#   node -e "console.log(require('bcryptjs').hashSync('your_secure_password', 10))"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Cloudflare Turnstile Server Secret
# In development, Cloudflare test key is 1x0000000000000000000000000000000AA
# In production, this MUST be your live Cloudflare Turnstile secret key.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Metered TURN Server (Server-side only — never expose to client)
METERED_API_KEY=
METERED_USERNAME=
METERED_PASSWORD=

# Allowed CORS Origins (comma-separated or single URL, defaults to * in dev)
CORS_ORIGIN=http://localhost:5173

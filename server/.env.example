# Server Port
PORT=5000

# Groq API Key (for Milo chat companion)
GROQ_API_KEY=your_groq_api_key_here

# Administrative Moderation Secret Token
ADMIN_SECRET=your_admin_secret_key_here

# Metered TURN Server (Server-side only — never expose to client)
METERED_API_KEY=your_metered_api_key_here
METERED_USERNAME=your_metered_username_here
METERED_PASSWORD=your_metered_password_here

# Allowed CORS Origins (comma-separated or single URL, defaults to * in dev)
CORS_ORIGIN=http://localhost:5173
